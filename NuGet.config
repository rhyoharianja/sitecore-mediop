<?xml version="1.0" encoding="utf-8"?>
<!--
	Feeds needed to restore this project on its own, with no other solution present.

	The Sitecore feed is public and needs no credentials; it carries the platform assemblies
	(Sitecore.Kernel, Sitecore.Logging, Sitecore.Mvc) and the SXA ones.

	clear drops any feed inherited from a machine level NuGet.config, so a build here restores
	from exactly these two and nothing else.
-->
<configuration>
	<packageSources>
		<clear />
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
		<add key="sitecore-public" value="https://nuget.sitecore.com/resources/v3/index.json" protocolVersion="3" />
	</packageSources>
</configuration>
