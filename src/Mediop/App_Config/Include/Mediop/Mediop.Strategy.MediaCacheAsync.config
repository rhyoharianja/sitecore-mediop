<!--
	STRATEGY: async, via a replacement media cache. This is the default and the one to keep on
	content delivery.

	The first visitor to request a given image size gets it resized but not yet optimized, and waits
	for nothing. Optimization happens on a bounded background queue, and every later request is served
	the optimized bytes from the media cache.

	Only one strategy may be active at a time. To switch, disable this file and enable
	Mediop.Strategy.GetMediaStreamSync.config.disabled.
-->
<configuration xmlns:patch="http://www.sitecore.net/xmlconfig/">
	<sitecore>
		<pipelines>
			<initialize>
				<processor type="Mediop.Invokers.MediaCacheAsync.Pipelines.Initialize.MediaCacheReplacer, Mediop" />
			</initialize>
		</pipelines>
	</sitecore>
</configuration>
