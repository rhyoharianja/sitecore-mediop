<!--
	SVG optimization via SVGO.

	SvgIgnorer is the important half: without it Sitecore tries to resize SVGs through GDI and fills
	the log with errors on every request.

	Gzipping is left off because IIS dynamic compression already handles SVG on this platform.
	Turn it on only if compression is disabled at the web server, and enable the media:request
	handler with it so the browser is told the payload is gzipped.
-->
<configuration xmlns:patch="http://www.sitecore.net/xmlconfig/">
	<sitecore>
		<pipelines>
			<mediopOptimize>
				<processor type="Mediop.Processors.Pipelines.MediopOptimize.ExtensionBasedOptimizer, Mediop" desc="svg">
					<Extensions>svg</Extensions>
					<Pipeline>mediopOptimizeSvg</Pipeline>
				</processor>
			</mediopOptimize>

			<mediopOptimizeSvg>
				<processor type="Mediop.Optimizers.Pipelines.MediopSvg.SvgoOptimizer, Mediop">
					<ExePath>/App_Data/Mediop Tools/SVGO/svgo-win.exe</ExePath>
					<!-- a bare dash tells svgo to read stdin and write stdout -->
					<AdditionalToolArguments>-</AdditionalToolArguments>
				</processor>

				<!-- gzip the optimized SVG into the media cache; pair with the media:request handler below
				<processor type="Mediop.Optimizers.Pipelines.MediopSvg.GzipSvgData, Mediop" />
				-->
			</mediopOptimizeSvg>

			<getMediaStream>
				<!-- must run before Sitecore tries to treat the SVG as a bitmap -->
				<processor type="Mediop.Svg.Pipelines.GetMediaStream.SvgIgnorer, Mediop" patch:before="processor[1]">
					<!-- true optimizes the SVG inline before aborting. Only set this when the async media
					     cache strategy is off, otherwise the async path never sees the SVG. -->
					<SynchronouslyOptimizeSvgs>false</SynchronouslyOptimizeSvgs>
				</processor>
			</getMediaStream>
		</pipelines>

		<!-- Enable together with GzipSvgData
		<events>
			<event name="media:request">
				<handler type="Mediop.Svg.EventHandlers.MediaRequest.CompressedSvgEncodingSetter, Mediop" method="OnMediaRequest" />
			</event>
		</events>
		-->
	</sitecore>
</configuration>
