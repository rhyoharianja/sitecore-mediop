<!--
	JPEG optimization via mozjpeg.

	Two modes ship here: lossy re-encode with cjpeg (enabled, best savings) and lossless rewrite with
	jpegtran (commented out, use it when the brand team will not accept any generation loss).
-->
<configuration xmlns:patch="http://www.sitecore.net/xmlconfig/">
	<sitecore>
		<pipelines>
			<mediopOptimize>
				<!-- desc must be unique across all mediopOptimize processors -->
				<processor type="Mediop.Processors.Pipelines.MediopOptimize.ExtensionBasedOptimizer, Mediop" desc="jpeg">
					<Extensions>jpg, jpeg, jfif, jpe</Extensions>
					<Pipeline>mediopOptimizeJpeg</Pipeline>
				</processor>
			</mediopOptimize>

			<!--
				Optimizers run in order and each one hands its output to the next.
				Every optimizer is expected to close the stream it receives.
			-->
			<mediopOptimizeJpeg>
				<!-- lossy, quality 80, progressive by default -->
				<processor type="Mediop.Optimizers.Pipelines.MediopJpeg.MozJpegOptimizer, Mediop">
					<ExePath>/App_Data/Mediop Tools/mozjpeg/cjpeg.exe</ExePath>
					<AdditionalToolArguments>-quality 80</AdditionalToolArguments>
				</processor>

				<!-- lossless alternative: swap it in for the one above
				<processor type="Mediop.Optimizers.Pipelines.MediopJpeg.MozJpegOptimizer, Mediop">
					<ExePath>/App_Data/Mediop Tools/mozjpeg/jpegtran.exe</ExePath>
					<AdditionalToolArguments>-optimize -copy none -progressive</AdditionalToolArguments>
				</processor>
				-->
			</mediopOptimizeJpeg>
		</pipelines>

		<settings>
			<!--
				Sitecore resizes JPEGs at quality 95 out of the box, which is far past the point of
				visible benefit and simply wastes bandwidth. 80 is the project default: the usual
				quality/size sweet spot, and it shrinks resized images before Mediop even sees them.

				Note this is a GLOBAL Sitecore setting - it affects every resize, not only the ones
				Mediop optimizes. Remove this settings block to leave the platform default alone.
			-->
			<setting name="Media.Resizing.Quality">
				<patch:attribute name="value">80</patch:attribute>
			</setting>
		</settings>
	</sitecore>
</configuration>
