<!--
	Base for next generation format support: WebP, AVIF, JPEG XL.

	How it works: the media handler reads the Accept header the browser sent, the
	mediopGetSupportedFormats pipeline turns it into a list of extensions, and an optimizer transcodes
	into the first supported one. A browser that never asked for WebP keeps getting JPEG, so there is
	no fallback logic to write in the front end.

	This file only declares the pipeline and the media types. Enable a format with its z.0x file.

	REQUIRED web.config change - the stock media handler does not read the Accept header:

	  <add verb="*" path="sitecore_media.ashx"
	       type="Mediop.NextGenFormats.MediaRequestHandler, Mediop"
	       name="Sitecore.MediaRequestHandler" />

	On an SXA site use Mediop.NextGenFormats.MediaRequestHandlerXA, Mediop instead, so the SXA
	mediaRequestHandler pipeline keeps running.
-->
<configuration xmlns:patch="http://www.sitecore.net/xmlconfig/">
	<sitecore>
		<pipelines>
			<!-- one CheckSupport processor per enabled format, added by the z.0x files -->
			<mediopGetSupportedFormats />
		</pipelines>

		<mediaLibrary>
			<mediaTypes>
				<!-- lets editors upload .webp directly, and serves it without forcing a download -->
				<mediaType name="WebP image" extensions="webp">
					<mimeType>image/webp</mimeType>
					<forceDownload>false</forceDownload>
					<sharedTemplate>system/media/unversioned/image</sharedTemplate>
					<versionedTemplate>system/media/versioned/image</versionedTemplate>
					<mediaValidator type="Sitecore.Resources.Media.ImageValidator" />
					<thumbnails>
						<!-- GDI cannot decode WebP, so thumbnails go through cwebp -->
						<generator type="Mediop.NextGenFormats.WebP.WebPThumbnailGenerator, Mediop">
							<extension>webp</extension>
						</generator>
						<width>150</width>
						<height>150</height>
					</thumbnails>
					<prototypes>
						<media type="Mediop.NextGenFormats.WebP.WebPMedia, Mediop" />
					</prototypes>
				</mediaType>

				<mediaType name="Avif image" extensions="avif">
					<mimeType>image/avif</mimeType>
					<forceDownload>false</forceDownload>
					<sharedTemplate>system/media/unversioned/image</sharedTemplate>
					<versionedTemplate>system/media/versioned/image</versionedTemplate>
					<mediaValidator type="Sitecore.Resources.Media.ImageValidator" />
				</mediaType>
			</mediaTypes>

			<requestProtection>
				<!-- the extension query string has to be allowed through the media request hash -->
				<protectedMediaQueryParameters>
					<parameter description="extension" name="extension" />
				</protectedMediaQueryParameters>
			</requestProtection>
		</mediaLibrary>
	</sitecore>
</configuration>
