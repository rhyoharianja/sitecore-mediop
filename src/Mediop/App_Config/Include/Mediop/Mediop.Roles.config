<!--
	Role specific tuning. Same binaries and same pipelines everywhere; only the throughput knobs differ.

	Content delivery is the server that must not get slower. Everything there runs on the async
	strategy, so no visitor ever waits for an encoder, and the queue is deliberately narrow: one
	worker thread at below normal priority, so optimization only ever consumes CPU that request
	handling is not using. Media the editors will never publish is not worth the CPU either, hence
	the tighter size window.

	Content management does the opposite. Editors upload originals and preview them once, so a wider
	queue and a second worker warm the cache faster after a bulk upload, and the default size window
	from Mediop.config is kept - print resolution source images do live in the media library.

	Role is read from the role:define setting in web.config (or the SITECORE_ROLE environment
	variable in containers).
-->
<configuration xmlns:patch="http://www.sitecore.net/xmlconfig/" xmlns:role="http://www.sitecore.net/xmlconfig/role/">
	<sitecore role:require="ContentDelivery">
		<settings>
			<setting name="Mediop.Async.MaxConcurrentThreads">
				<patch:attribute name="value">1</patch:attribute>
			</setting>
			<setting name="Mediop.Async.MaxQueueLength">
				<patch:attribute name="value">500</patch:attribute>
			</setting>
			<!-- fail fast on delivery rather than holding a worker for a minute -->
			<setting name="Mediop.ToolTimeout">
				<patch:attribute name="value">20000</patch:attribute>
			</setting>
		</settings>

		<pipelines>
			<mediopOptimize>
				<processor type="Mediop.Processors.Pipelines.MediopOptimize.SizeThreshold, Mediop"
				           patch:instead="processor[@type='Mediop.Processors.Pipelines.MediopOptimize.SizeThreshold, Mediop']">
					<MinimumSizeInBytes>2048</MinimumSizeInBytes>
					<MaximumSizeInBytes>10485760</MaximumSizeInBytes>
				</processor>
			</mediopOptimize>
		</pipelines>
	</sitecore>

	<sitecore role:require="ContentManagement or Standalone">
		<settings>
			<setting name="Mediop.Async.MaxConcurrentThreads">
				<patch:attribute name="value">2</patch:attribute>
			</setting>
			<setting name="Mediop.Async.MaxQueueLength">
				<patch:attribute name="value">1000</patch:attribute>
			</setting>
		</settings>
	</sitecore>
</configuration>
