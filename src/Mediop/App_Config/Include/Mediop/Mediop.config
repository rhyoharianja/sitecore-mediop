<!--
	Mediop - automatic media library image optimization.

	This file sets up the mediopOptimize pipeline, which every format specific config patches into.
	It optimizes nothing on its own: the per format files (Mediop.Jpeg.config, Mediop.Png.config, ...)
	decide which tool handles which extension.

	Load order matters. Keep this file named so it sorts before the format files.
-->
<configuration xmlns:patch="http://www.sitecore.net/xmlconfig/" xmlns:set="http://www.sitecore.net/xmlconfig/set/">
	<sitecore>
		<settings>
			<!-- Temp folder used by the command line tools. Empty means the Windows temp folder.
			     Point this at a data drive if the system drive is tight on space. -->
			<setting name="Mediop.TempFilePath" value="" />

			<!-- How long a single tool may run before it is killed, in ms. -->
			<setting name="Mediop.ToolTimeout" value="60000" />

			<!-- Background encoder threads used by the async strategy. Image encoders are CPU bound and
			     share the machine with request handling, so raising this trades page speed for faster
			     cache warming. -->
			<setting name="Mediop.Async.MaxConcurrentThreads" value="1" />

			<!-- Pending optimizations held before new ones are dropped. A dropped image is simply served
			     unoptimized and retried on the next request. -->
			<setting name="Mediop.Async.MaxQueueLength" value="500" />

			<!-- Next generation formats are opt in; see the z.0x files. -->
			<setting name="Mediop.CDN.Enabled" value="false" />
		</settings>

		<pipelines>
			<!--
				MEDIOP OPTIMIZE
				Decides what happens to a media stream. Processors run in order:
				  1. guards that abort for media we do not want to touch
				  2. one ExtensionBasedOptimizer per format, which dispatches to a format pipeline
			-->
			<mediopOptimize>
				<!-- Honours enableMediop="false" on a site definition, including SXA site grouping items. -->
				<processor type="Mediop.Processors.Pipelines.MediopOptimize.DisableMediopForSite, Mediop" />

				<!-- Skips media outside this size window. Files under 1 KB rarely shrink enough to pay for
				     the process spawn; files over 20 MB can tie up a worker for seconds. 0 disables a bound. -->
				<processor type="Mediop.Processors.Pipelines.MediopOptimize.SizeThreshold, Mediop">
					<MinimumSizeInBytes>1024</MinimumSizeInBytes>
					<MaximumSizeInBytes>20971520</MaximumSizeInBytes>
				</processor>
			</mediopOptimize>
		</pipelines>

		<sites>
			<!-- The Content Editor and Experience Editor gain nothing from optimized images and lose
			     responsiveness, so leave the shell off. -->
			<site name="shell" set:enableMediop="false" />
		</sites>
	</sitecore>
</configuration>
