<!--
	Sends Mediop output to its own log file, so per image optimization chatter stays out of the
	main Sitecore log. Set level to DEBUG while tuning, INFO once it is in production, WARN if the
	volume is still too high.
-->
<configuration xmlns:patch="http://www.sitecore.net/xmlconfig/">
	<sitecore>
		<log4net>
			<appender name="MediopFileAppender" type="log4net.Appender.SitecoreLogFileAppender, Sitecore.Logging">
				<file value="$(dataFolder)/logs/Mediop.log.{date}.txt" />
				<appendToFile value="true" />
				<layout type="log4net.Layout.PatternLayout">
					<conversionPattern value="%4t %d{ABSOLUTE} %-5p %m%n" />
				</layout>
				<encoding value="utf-8" />
			</appender>
			<logger name="Mediop" additivity="false">
				<level value="INFO" />
				<appender-ref ref="MediopFileAppender" />
			</logger>
		</log4net>
	</sitecore>
</configuration>
