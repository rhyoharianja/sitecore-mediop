<!--
	JPEG XL. Best compression of the three, but no mainstream browser ships it enabled by default,
	so in practice nothing will ever request it. Kept here so the option is one rename away if that
	changes.

	Requires Mediop.NextGenFormats.config.
-->
<configuration xmlns:patch="http://www.sitecore.net/xmlconfig/">
	<sitecore>
		<pipelines>
			<mediopGetSupportedFormats>
				<processor type="Mediop.NextGenFormats.Pipelines.CheckSupport, Mediop" desc="jxl">
					<Extension>jxl</Extension>
				</processor>
			</mediopGetSupportedFormats>

			<mediopOptimizeJpeg>
				<processor type="Mediop.Optimizers.Pipelines.MediopJxl.JxlOptimizer, Mediop"
				           patch:after="processor[@type='Mediop.Optimizers.Pipelines.MediopJpeg.MozJpegOptimizer, Mediop']">
					<ExePath>/App_Data/Mediop Tools/jxl/cjxl.exe</ExePath>
					<!-- cjxl aborts with "failed to choose default num_threads" unless the count is explicit -->
					<AdditionalToolArguments>-q 85 --num_threads 2</AdditionalToolArguments>
				</processor>
			</mediopOptimizeJpeg>
		</pipelines>

		<mediaLibrary>
			<mediaTypes>
				<mediaType name="JPEG XL image" extensions="jxl">
					<mimeType>image/jxl</mimeType>
					<forceDownload>false</forceDownload>
					<sharedTemplate>system/media/unversioned/image</sharedTemplate>
					<versionedTemplate>system/media/versioned/image</versionedTemplate>
				</mediaType>
			</mediaTypes>
		</mediaLibrary>
	</sitecore>
</configuration>
